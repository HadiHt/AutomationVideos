HOST=127.0.0.1
PORT=3455
APP_BASE_URL=http://127.0.0.1:3455

TIKTOK_PLATFORM=desktop

TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

TIKTOK_SCOPES=user.info.basic,video.publish
TIKTOK_REDIRECT_PATH=/api/tiktok/callback

PIPER_EXECUTABLE=piper

PIPER_MODEL_PATH=C:\path\to\voices\en_US-lessac-high.onnx
PIPER_VOICE_CONFIG_PATH=

PIPER_ARGS_JSON=["--length_scale","1.06","--sentence_silence","0.2"]
VOICE_MASTERING_ENABLED=true
VOICE_MASTERING_FILTER=highpass=f=70,lowpass=f=10500,acompressor=threshold=-18dB:ratio=2.5:attack=20:release=180:makeup=1.5,loudnorm=I=-16:LRA=7:TP=-1.5
FFMPEG_EXECUTABLE=ffmpeg

COMFYUI_BASE_URL=http://127.0.0.1:8188
COMFYUI_WORKFLOW_PATH=workflows/comfyui_api.json

RENDERER_PYTHON_EXECUTABLE=python
RENDERER_SCRIPT_PATH=tools/render_video.py
BACKGROUND_MUSIC_PATH=
CAPTION_FONT_PATH=
CAPTION_FALLBACK_FONT=Arial
FFPROBE_EXECUTABLE=ffprobe

IMAGE_WIDTH=1080
IMAGE_HEIGHT=1920
VIDEO_FPS=30
VIDEO_TRANSITION_SECONDS=0.35
VIDEO_ZOOM_STRENGTH=0.12
PROMPT_SUFFIX=cinematic, realistic, dramatic lighting, high detail, vertical 9:16, TikTok background, no text, no logos, no watermark
DEFAULT_SCENE_COUNT_MIN=6
DEFAULT_SCENE_COUNT_MAX=10
CAPTION_WORDS_PER_CHUNK=4

DATA_DIR=data
RUNTIME_DIR=data/runtime
